# Supabase (Auth + Postgres + Storage)
# Create a project at https://supabase.com and paste the values below.
# Disable "Confirm email" in Authentication > Providers if you want
# avatar upload to complete in the same signup session.
# Apply supabase/migrations in the SQL editor, or with: npx supabase db push
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

VITE_TWELVEDATA_KEY=
VITE_BRAPI_KEY=
